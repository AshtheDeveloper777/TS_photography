# Supabase Storage & Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: Server-only Service Role Key (NEVER expose to client)
# Needed only if TS_photography bucket is kept private and signed URLs are generated
SUPABASE_SERVICE_ROLE_KEY=

# Studio Contact Information (Leave blank to hide in UI until verified)
NEXT_PUBLIC_STUDIO_PHONE=
NEXT_PUBLIC_STUDIO_WHATSAPP=
NEXT_PUBLIC_STUDIO_EMAIL=
NEXT_PUBLIC_STUDIO_ADDRESS=
NEXT_PUBLIC_STUDIO_INSTAGRAM=

# Optional Notification Provider
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=
